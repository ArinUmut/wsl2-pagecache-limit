# Merged over Microsoft/config-wsl by scripts/build.sh.
#
# 1) KVM and vhost built in, for nested VMs (e.g. Firecracker) inside WSL.
#    VHOST_NET can only be =m: it depends on (TUN || !TUN) and WSL builds TUN
#    as a module.
CONFIG_KVM=y
CONFIG_KVM_AMD=y
CONFIG_VHOST=y
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=y
CONFIG_VSOCKETS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
#
# 2) Hardening beyond Microsoft's config-wsl. RANDSTRUCT is deliberately left
#    off: the GCC randstruct plugin disables DEBUG_INFO_BTF
#    (lib/Kconfig.debug: depends on !GCC_PLUGIN_RANDSTRUCT), and BTF is needed
#    by CO-RE BPF tools, sched_ext and systemd BPF features.
#    Needs gcc-<ver>-plugin-dev; build.sh refuses to build without it.
CONFIG_GCC_PLUGINS=y
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=y
CONFIG_DEBUG_INFO_BTF=y
#
# 3) The page cache limit itself has no Kconfig symbol: mm/pagecache_limit.o
#    is built whenever CONFIG_MEMCG=y and stays off until a limit is set.
CONFIG_MEMCG=y
