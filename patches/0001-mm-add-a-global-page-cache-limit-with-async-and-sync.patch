diff --git a/include/linux/pagecache_limit.h b/include/linux/pagecache_limit.h
new file mode 100644
index 000000000..85273e761
--- /dev/null
+++ b/include/linux/pagecache_limit.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_PAGECACHE_LIMIT_H
+#define _LINUX_PAGECACHE_LIMIT_H
+
+#include <linux/jump_label.h>
+#include <linux/types.h>
+
+struct address_space;
+struct folio;
+
+#ifdef CONFIG_MEMCG
+DECLARE_STATIC_KEY_FALSE(pagecache_limit_key);
+
+void __pagecache_limit_charge(struct address_space *mapping,
+			      struct folio *folio, gfp_t gfp);
+
+/*
+ * Called by filemap_add_folio() for every folio that enters the page cache,
+ * before the folio is charged, locked or inserted, with the gfp mask of the
+ * insertion.  Compiles to a patched-out jump unless a limit is set
+ * (see mm/pagecache_limit.c).
+ */
+static inline void pagecache_limit_charge(struct address_space *mapping,
+					  struct folio *folio, gfp_t gfp)
+{
+	if (static_branch_unlikely(&pagecache_limit_key))
+		__pagecache_limit_charge(mapping, folio, gfp);
+}
+#else
+static inline void pagecache_limit_charge(struct address_space *mapping,
+					  struct folio *folio, gfp_t gfp)
+{
+}
+#endif
+
+#endif /* _LINUX_PAGECACHE_LIMIT_H */
